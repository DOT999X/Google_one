# Copy to .env and fill in values

# Model directory (default: ./models)
MODEL_DIR=models

# Google Cloud project ID
GCP_PROJECT=your-gcp-project-id

# Cloud Storage bucket for uploaded images
GCS_BUCKET=agrin-images

# Gemini API key (get from Google AI Studio — free tier)
GEMINI_API_KEY=your-gemini-api-key

# Google Earth Engine (optional — for real Sentinel-2 NDVI)
# Leave empty to use NASA POWER proxy instead
GEE_SERVICE_ACCOUNT=
GEE_KEY_PATH=gee-service-account.json
